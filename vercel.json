{
  "installCommand": "npm install --cpu=x64 --os=linux --libc=glibc",
  "buildCommand": "ls node_modules/@img 2>/dev/null | grep -v linux-x64 | xargs -I{} rm -rf node_modules/@img/{} ; mkdir -p public && echo 'sharp pruned'",
  "outputDirectory": "public",
  "functions": {
    "api/sync-orders.js": { "maxDuration": 60 },
    "api/auto-post.js":   { "maxDuration": 45 }
  },
  "crons": [
    { "path": "/api/sync-orders", "schedule": "0 3 * * *" },
    { "path": "/api/sync-orders?job=email-campaign", "schedule": "0 20 * * *" },
    { "path": "/api/auto-post", "schedule": "0 6 * * *" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
